# Copy this file to .env and fill in your own values. .env is gitignored.

# Notion integration — the watchlist (自选列表) is read from a Notion database.
# Create an internal integration at https://www.notion.so/my-integrations,
# share the database with it, then paste the token + database id below.
NOTION_TOKEN=
NOTION_DATABASE_ID=

# HTTP server port (optional, defaults to 5174)
PORT=5174
